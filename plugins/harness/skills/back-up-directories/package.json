{
  "name": "back-up-directories",
  "version": "1.0.0",
  "description": "Interactive ZIP backup utility, packaged as an Agent Skill.",
  "homepage": "https://github.com/kylesaburao/harness-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylesaburao/harness-plugin.git"
  },
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "scripts/backup.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "backup": "node scripts/backup.js",
    "preflight": "node scripts/backup.js --preflight --json",
    "benchmark": "node scripts/backup-benchmark.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/backup.js tests/*.test.js"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  }
}

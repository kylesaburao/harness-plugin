#!/bin/sh
# Verify outgoing committed snapshots, never the caller's working distribution.
set -eu

root=$(git rev-parse --show-toplevel)
root=$(CDPATH= cd "$root" && pwd -P)
git_env=$(git rev-parse --local-env-vars)
owned=
selected='push input'
step='prepare snapshots'
cleanup() {
    status=$?
    trap - 0
    if [ -n "$owned" ] && ! rm -rf "$owned"; then
        echo "pre-push: cleanup failed: $owned" >&2
        status=1
    fi
    if [ "$status" -ne 0 ]; then
        echo "pre-push: FAILED $selected ($step)." >&2
        echo 'Remedy: fix the reported prerequisite, run npm run build (Linux: ./scripts/dev exec npm run build), commit source and dist together, then retry.' >&2
    fi
    exit "$status"
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -p "$root/.build"
owned=$(mktemp -d "$root/.build/pre-push-XXXXXX")
# Buffer before any command can consume the Git protocol input.
cat > "$owned/records"
: > "$owned/tips"
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    selected="$local_ref $local_oid"
    step='resolve outgoing commit'
    commit=$(git rev-parse --verify "$local_oid^{commit}") || exit 1
    if ! grep -q "^$commit " "$owned/tips"; then
        printf '%s %s\n' "$commit" "$local_ref" >> "$owned/tips"
    fi
done < "$owned/records"
[ -s "$owned/tips" ] || exit 0
platform=$(uname -s)
case "$platform" in
    Darwin) command -v npm >/dev/null && command -v node >/dev/null || {
        echo 'pre-push: Node.js and npm are required. Install the development tools in docs/development/dependencies.md.' >&2
        exit 1
    } ;;
    Linux) [ -x "$root/scripts/dev" ] || { echo 'pre-push: missing executable scripts/dev.' >&2; exit 1; } ;;
    *) echo "pre-push: unsupported platform: $platform" >&2; exit 1 ;;
esac
# Git location/index variables belong to the caller, not the standalone clone.
isolated() (
    for name in $git_env; do unset "$name"; done
    "$@"
)
run() {
    # Wait for the command to finish before traps remove its snapshot.
    "$@" < /dev/null
}
while read -r commit local_ref; do
    selected="$local_ref $commit"
    echo "pre-push: checking $selected" >&2
    snapshot="$owned/$commit"
    step='clone committed snapshot'
    run isolated git -c core.hooksPath=/dev/null clone -q --no-checkout --no-hardlinks --dissociate "$root" "$snapshot"
    run isolated git -C "$snapshot" config core.hooksPath /dev/null
    step='checkout committed snapshot'
    run isolated git -C "$snapshot" checkout -q --detach "$commit"
    # npm ci must never follow a committed dependency symlink outside the snapshot.
    step='check snapshot dependency location'
    if [ -e "$snapshot/node_modules" ] || [ -L "$snapshot/node_modules" ]; then
        echo 'pre-push: committed root node_modules is not permitted. Remove it from Git.' >&2
        exit 1
    fi
    step='install locked build dependencies and verify distribution'
    if [ "$platform" = Darwin ]; then
        run isolated sh -ec '
            cd "$1"
            npm ci --include=dev
            npm run build:check
            node scripts/validate-dist.js --tracked
        ' pre-push "$snapshot"
    else
        step='export committed index inventory'
        isolated git -C "$snapshot" ls-files --stage -z -- dist > "$owned/$commit.index"
        container_owned="/workspace/harness-plugin/.build/${owned##*/}"
        step='container: install locked build dependencies and verify distribution'
        run isolated "$root/scripts/dev" exec sh -ec '
            cd "$1"
            npm ci --include=dev
            npm run build:check
            node scripts/validate-dist.js --tracked-records "$2"
        ' pre-push "$container_owned/$commit" "$container_owned/$commit.index"
    fi
    rm -rf "$snapshot"
done < "$owned/tips"
